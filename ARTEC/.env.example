# Copier en .env (jamais versionne) puis renseigner les valeurs.
DJANGO_DEBUG=True
# Generer : python -c "import secrets; print(secrets.token_urlsafe(60))"
DJANGO_SECRET_KEY=remplacez-par-une-longue-valeur-aleatoire
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (voir docs/INSTALL_WINDOWS.md, etape 2)
DB_NAME=artec
DB_USER=artec
DB_PASSWORD=remplacez-moi
DB_HOST=localhost
DB_PORT=5432

# Moteur ML : local (moteur complet, par defaut) | local_basic (ancien moteur v0.1, repli) | unavailable (desactive)
ML_ENGINE_BACKEND=local
# Sel de pseudonymisation du moteur ML (facultatif : derive de DJANGO_SECRET_KEY si absent). A garder secret.
# ML_VISITOR_SALT=
# Nombre minimal d'avis pour qu'un resultat soit considere fiable (indicateurs et recommandations)
ARTEC_MIN_SAMPLE=30
